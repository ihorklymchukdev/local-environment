<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Omelet @VERSION@</title>
    <organization>dev.omelet</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- The build is native-arch, not universal: a copy built on Apple Silicon
         must refuse an Intel Mac rather than install binaries it cannot run. -->
    <options customize="never" require-scripts="true" hostArchitectures="@ARCH@"/>

    <!-- Lima is asked for vmType: vz in host/providers/omelet.yaml, which is
         Apple's own virtualization framework and needs macOS 13. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="dev.omelet.app"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.omelet.app" visible="false">
        <pkg-ref id="dev.omelet.app"/>
    </choice>
    <pkg-ref id="dev.omelet.app" version="@VERSION@">Omelet-component.pkg</pkg-ref>
</installer-gui-script>
