{
  // Three debug targets, easiest first. See .vscode/README-debugging.md.
  "version": "0.2.0",
  "configurations": [
    {
      // Start here. The suite runs every module against fakes -- no VM, no
      // containers -- so a breakpoint in agent/core or host/ is reached in
      // about a second.
      "name": "Tests: whole suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests: current file, stop on first failure",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "-x", "--pdb", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // The agent as an ordinary local process: no image, no VM, native
      // stepping. It will drive whatever Docker this shell can reach, which
      // on this machine is Docker Desktop's engine, NOT omelet-vm's --
      // /usr/bin/docker here is a symlink into /mnt/wsl/docker-desktop.
      // Fine for stepping through routing, parsing and overlay generation.
      // Create the token first:  mkdir -p .debug && echo dev > .debug/agent.token
      "name": "Agent: run locally (no container)",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.api",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "OMELET_PROJECTS_ROOT": "${workspaceFolder}/.debug/projects",
        "OMELET_STATE_DB": "${workspaceFolder}/.debug/state.db",
        "OMELET_AGENT_TOKEN": "${workspaceFolder}/.debug/agent.token",
        "OMELET_TRAEFIK_HOST": "127.0.0.1",
        "OMELET_AGENT_PORT": "39099"
      }
    },
    {
      // The real agent, in its container, in the VM. Requires the debug image
      // and the compose override -- see the README. Breakpoints only bind if
      // pathMappings is right; a hollow breakpoint means it is not.
      "name": "Agent: attach to the VM",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/agent",
          "remoteRoot": "/usr/local/lib/python3.12/site-packages/agent"
        }
      ]
    },
    {
      // WINDOWS ONLY. host/providers/__init__.py raises
      // "unsupported host platform: linux" from a WSL shell, so this one has
      // to run from a VS Code window opened on the Windows checkout.
      "name": "Host CLI: omelet up ./demo  (Windows only)",
      "type": "debugpy",
      "request": "launch",
      "module": "host.cli",
      "args": ["up", ".\\demo"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Host CLI: omelet status  (Windows only)",
      "type": "debugpy",
      "request": "launch",
      "module": "host.cli",
      "args": ["status"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
