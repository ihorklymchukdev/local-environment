# The released agent image plus debugpy, for stepping through the agent while
# it runs in the VM. Not part of any build or release path -- stack.debug.yml
# is the only thing that references it.
#
# It has no build context of its own, so it can be built straight into the VM
# over stdin:
#   docker build -t omelet-agent:debug - < agent/Dockerfile.debug
ARG AGENT_IMAGE=ghcr.io/ihorklymchukdev/omelet-agent:0.1.0
FROM ${AGENT_IMAGE}

USER root
RUN pip install --no-cache-dir debugpy==1.8.5
USER agent

# No --wait-for-client: the container starts and serves normally, and the
# debugger attaches whenever you want it. Waiting would hang the HEALTHCHECK
# and leave restart:always looping a container nobody has attached to yet.
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "agent.api"]
